{
  "name": "inkblast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "balance": "esbuild scripts/balance-report.ts --bundle --platform=node --format=esm --outfile=artifacts/balance-runner.mjs && node artifacts/balance-runner.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html .github/workflows/*.yml"
  },
  "dependencies": {
    "pixi.js": "^8.14.0"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
